<UserControl x:Class="GameWake.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GameWake.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:OperationRowViewModel}">
            <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="0" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="16" FontStretch="Expanded" />
                    <TextBlock Text="{Binding TitleNote}" Style="{StaticResource Label}" Margin="0,2,0,0"
                               Visibility="{Binding HasTitleNote, Converter={StaticResource BoolToVisibility}}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource Pill}" Background="{Binding StateTone, Converter={StaticResource ToneBackground}}" Margin="0,0,8,6">
                            <TextBlock Text="{Binding StateText}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold"
                                       Foreground="{Binding StateTone, Converter={StaticResource ToneForeground}}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource SubtleFillBrush}" Margin="0,0,8,6"
                                Visibility="{Binding ConfidenceText, Converter={StaticResource NonEmptyToVisibility}}">
                            <TextBlock Text="{Binding ConfidenceText}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding StateDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding StateDetail, Converter={StaticResource NonEmptyToVisibility}}" />
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Margin="0,10,0,0"
                                 Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Label}" Margin="0,8,0,0"
                               Visibility="{Binding HasProgressText, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ProgressNote}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding HasProgressNote, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding MetaText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"
                               Visibility="{Binding HasMeta, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{StaticResource Pill}" Background="{StaticResource AmberTintBrush}" Margin="0,8,0,0"
                            Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="SIMULATED" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource AmberBrush}" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LauncherCardViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top"
                                Background="{Binding Accent}">
                            <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="18" FontStretch="Expanded" />
                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Top"
                                Background="{Binding RunningTone, Converter={StaticResource ToneBackground}}">
                            <TextBlock Text="{Binding RunningText}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold"
                                       Foreground="{Binding RunningTone, Converter={StaticResource ToneForeground}}" />
                        </Border>
                    </Grid>

                    <WrapPanel Margin="0,14,0,0">
                        <Border Style="{StaticResource Pill}" Background="{Binding StateTone, Converter={StaticResource ToneBackground}}" Margin="0,0,8,6">
                            <TextBlock Text="{Binding StateText}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold"
                                       Foreground="{Binding StateTone, Converter={StaticResource ToneForeground}}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource SubtleFillBrush}" Margin="0,0,8,6"
                                Visibility="{Binding ConfidenceText, Converter={StaticResource NonEmptyToVisibility}}">
                            <TextBlock Text="{Binding ConfidenceText}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource AmberBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Operations}" Margin="0,12,0,0"
                                  Visibility="{Binding HasOperations, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="No current game operations." Style="{StaticResource Caption}" Margin="0,12,0,0"
                               Visibility="{Binding HasOperations, Converter={StaticResource InverseBoolToVisibility}}" />

                    <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Caption}" Margin="0,12,0,0"
                               Visibility="{Binding SpeedText, Converter={StaticResource NonEmptyToVisibility}}" />
                    <TextBlock Text="{Binding CheckedText}" Style="{StaticResource Label}" Margin="0,6,0,0" />

                    <ItemsControl ItemsSource="{Binding Details}" Margin="0,10,0,0"
                                  Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Label}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16,10,16">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            <TextBlock Text="What GameWake can see right now, and whether the PC is being kept awake." Style="{StaticResource Caption}" Margin="0,6,0,18" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left"
                            Background="{Binding StatusTone, Converter={StaticResource ToneBackground}}">
                        <TextBlock Text="{Binding StatusTitle}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding StatusTone, Converter={StaticResource ToneForeground}}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding StatusSubtitle}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                               Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusHint}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Visibility="{Binding StatusHint, Converter={StaticResource NonEmptyToVisibility}}" />
                    <WrapPanel Margin="0,16,0,0">
                        <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,10,10" MinWidth="120">
                            <StackPanel>
                                <TextBlock Text="ACTIVE" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding ActiveCountText}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,10,10" MinWidth="120">
                            <StackPanel>
                                <TextBlock Text="HELD FOR" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding DurationText}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10" MinWidth="140">
                            <StackPanel>
                                <TextBlock Text="KEEPING AWAKE" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding ResponsibleText}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource AmberTintBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1"
                    CornerRadius="0" Padding="12,10" Margin="0,0,0,16"
                    Visibility="{Binding ShowSimulationBanner, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SimulationBanner}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="LAUNCHERS" Style="{StaticResource SectionTitle}" Margin="0,4,0,10" />
            <ItemsControl ItemsSource="{Binding Cards}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
