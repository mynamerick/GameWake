<UserControl x:Class="GameWake.App.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="18,16,16,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Advanced" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Logs and diagnostics stay on this PC. Nothing is sent anywhere." Style="{StaticResource Caption}" Margin="0,6,0,0" />
        </StackPanel>

        <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Margin="0,0,0,16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="APPLICATION" Style="{StaticResource Label}" />
                    <TextBlock Margin="0,4,16,12"><Run Text="GameWake " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="DATA FOLDER" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Caption}" Margin="0,4,16,0" />
                    <TextBlock Text="LOGS FOLDER" Style="{StaticResource Label}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding LogsFolder}" Style="{StaticResource Caption}" Margin="0,4,16,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentLightBrush}" Margin="0,12,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NonEmptyToVisibility}}" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SubtleButton}" Content="OPEN LOGS FOLDER" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource SubtleButton}" Content="OPEN CURRENT LOG" Command="{Binding OpenCurrentLogCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource SubtleButton}" Content="OPEN DATA FOLDER" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource SubtleButton}" Content="EXPORT DIAGNOSTICS" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource SubtleButton}" Content="CLEAR ACTIVITY HISTORY" Command="{Binding ClearHistoryCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource SubtleButton}" Content="RESET SETTINGS" Command="{Binding ResetSettingsCommand}" Margin="0,0,8,8" />
                </WrapPanel>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="RECENT LOG" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
        <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding LogText, Mode=OneWay}"
                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 AutomationProperties.Name="Application log" />
    </DockPanel>
</UserControl>
